@startuml
title Inventory Management System - Component Diagram
package "Application" {
  [UI] as UI
}

package "Services" {
  [InventoryManager] as Manager
}

package "Data" {
  [ProductRepository] as ProdRepo
  [InventoryRepository] as InvRepo
  database "Database" as DB
}

UI --> Manager: calls
Manager --> ProdRepo: reads/writes
Manager --> InvRepo: reads/writes
ProdRepo --> DB: CRUD
InvRepo --> DB: CRUD

note left of UI
  Could be Console, Web UI,
  or API controller
end note

note right of DB
  SQL / NoSQL store
end note

@enduml
