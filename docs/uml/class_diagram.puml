@startuml
' Inventory Management System - Class Diagram
package "Domain" {
  class Product {
	+Guid Id
	+string SKU
	+string Name
	+string Description
	+decimal UnitPrice
	+int ReorderLevel
	+void UpdatePrice(decimal)
  }

  class InventoryItem {
	+Guid Id
	+Product Product
	+int QuantityOnHand
	+int Reserved
	+void AdjustQuantity(int)
  }

  class StockAdjustment {
	+Guid Id
	+InventoryItem Item
	+int QuantityChange
	+DateTime Timestamp
	+string Reason
  }

  class Supplier {
	+Guid Id
	+string Name
	+string ContactInfo
  }
}

package "Services" {
  interface IProductRepository {
	+Product Get(Guid id)
	+IEnumerable<Product> GetAll()
	+void Add(Product)
	+void Update(Product)
	+void Delete(Guid)
  }

  interface IInventoryRepository {
	+InventoryItem GetByProduct(Guid productId)
	+void Save(InventoryItem)
	+void RecordAdjustment(StockAdjustment)
  }

  class InventoryManager {
	-IProductRepository _products
	-IInventoryRepository _inventories
	+void CreateProduct(Product)
	+void AddStock(Guid productId, int quantity, string reason)
	+void RemoveStock(Guid productId, int quantity, string reason)
  }
}

Product "1" -- "0..*" InventoryItem : has >
InventoryItem "1" -- "0..*" StockAdjustment : records >
Supplier "1" -- "0..*" Product : supplies >

InventoryManager ..> IProductRepository : uses >
InventoryManager ..> IInventoryRepository : uses >

@enduml
